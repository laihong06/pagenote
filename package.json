{
  "name": "pagenote",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "node scripts/export-prompts.mjs && node scripts/create-icon.mjs && node scripts/notices.mjs && vite build && node scripts/build-mcp.mjs",
    "start": "node server.mjs",
    "test": "npm run test:release",
    "desktop": "electron .",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "package:mac": "npm run build && node scripts/package-desktop.mjs --mac",
    "package:mac:local": "npm run build && node scripts/package-desktop.mjs --mac --dir",
    "test:desktop": "npm run test:release",
    "test:markdown": "node tests/rich-editor.mjs",
    "test:mcp": "node tests/mcp.mjs",
    "package:dir": "npm run build && node scripts/package-desktop.mjs --dir",
    "test:release": "node tests/mac-word-host.mjs && node tests/mac-native.mjs && node tests/project-launch.mjs && node tests/project-open.mjs && node tests/file-ops.mjs && node tests/external-project.mjs && node tests/external-documents.mjs && node tests/migration.mjs && node tests/ai-settings.mjs && node tests/menus.mjs && node tests/box-tag.mjs && node tests/projects.mjs && node tests/i18n.mjs && node tests/math-input.mjs && node tests/multiline-display-math.mjs && node tests/formula-rendering.mjs && node tests/code-rendering.mjs && node tests/rich-editor.mjs && npm run test:reading && npm run test:note-conflicts",
    "test:reading": "node tests/continuous.mjs && node tests/ai-workspace.mjs",
    "test:english": "node tests/english-windows.mjs",
    "test:acceptance": "node tests/acceptance-recovery.mjs",
    "test:soak": "node tests/soak.mjs",
    "format": "prettier --write src desktop mcp scripts server.mjs projects.mjs external-documents.mjs index.html locales tests/*.mjs",
    "format:check": "prettier --check src desktop mcp scripts server.mjs projects.mjs external-documents.mjs index.html locales",
    "package:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/source-archive.ps1",
    "test:word": "node tests/default-word.mjs",
    "test:prepared": "node tests/prepared.mjs",
    "test:page-breaks": "node tests/page-breaks.mjs",
    "pretest:prepared": "node scripts/ensure-electron.mjs",
    "pretest:release": "node scripts/ensure-electron.mjs",
    "pretest:mcp": "node scripts/ensure-electron.mjs",
    "pretest:word": "node scripts/ensure-electron.mjs",
    "pretest:markdown": "node scripts/ensure-electron.mjs",
    "test:mac-office": "node tests/mac-word-host.mjs && node tests/mac-office.mjs && node tests/mac-office-app.mjs",
    "pretest:mac-office": "node scripts/ensure-electron.mjs",
    "test:version": "node tests/versioning.mjs && node scripts/check-release-version.mjs",
    "check:release": "node scripts/check-release-version.mjs --release",
    "test:footer": "node tests/footer-stability.mjs",
    "test:note-conflicts": "node tests/note-conflicts.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "@gutenye/ocr-node": "1.4.9",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.2.108",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.56.0",
    "dompurify": "^3.2.7",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "katex": "0.18.7",
    "marked": "^16.3.0",
    "marked-katex-extension": "^5.1.4",
    "mermaid": "^12.2.0",
    "prettier": "3.6.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vite": "^7.1.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@gutenye/ocr-node": {
      "sharp": "$sharp"
    }
  },
  "description": "Local-first document reading, page-linked Markdown notes and AI annotations",
  "author": "pagenote contributors",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "io.pagenote.desktop",
    "productName": "pagenote",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "skills/**",
      "server.mjs",
      "dist/**",
      "package.json",
      "node_modules/**",
      "!node_modules/vite/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "projects.mjs",
      "locales/**",
      "external-documents.mjs"
    ],
    "extraFiles": [
      {
        "from": "scripts/register-project-files.cmd",
        "to": "register-project-files.cmd"
      },
      {
        "from": "scripts/register-project-files.ps1",
        "to": "register-project-files.ps1"
      }
    ],
    "extraResources": [
      {
        "from": "desktop/word-host.ps1",
        "to": "word-host.ps1"
      },
      {
        "from": "convert-office.ps1",
        "to": "convert-office.ps1"
      },
      {
        "from": "mcp-dist/page-notes-mcp.cjs",
        "to": "page-notes-mcp.cjs"
      },
      {
        "from": "mcp-dist/node.exe",
        "to": "mcp-node.exe"
      },
      {
        "from": "mcp-dist/NODE-LICENSE.txt",
        "to": "NODE-LICENSE.txt"
      },
      {
        "from": "mcp-dist/node-runtime.json",
        "to": "node-runtime.json"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE-pagenote.txt"
      },
      {
        "from": "build/licenses/PaddleOCR-LICENSE.txt",
        "to": "LICENSE-PaddleOCR.txt"
      },
      {
        "from": "build/licenses/Guten-OCR-LICENSE.txt",
        "to": "LICENSE-Guten-OCR.txt"
      },
      {
        "from": "LICENSING.md",
        "to": "LICENSING.md"
      },
      {
        "from": "licenses/MIT-legacy.txt",
        "to": "licenses/MIT-legacy.txt"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "compression": "normal",
    "asarUnpack": [
      "node_modules/@gutenye/ocr-models/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "pagenote",
      "artifactName": "pagenote-${version}-windows-x64-setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "pagenote-${version}-windows-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "pagenote",
        "name": "pagenote Project",
        "description": "pagenote project",
        "role": "Editor"
      }
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
