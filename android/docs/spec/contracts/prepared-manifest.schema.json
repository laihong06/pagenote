{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prepared-manifest",
  "type": "object",
  "required": ["version", "documentId", "page", "sourceRevision", "kind", "region", "cacheKey", "width", "height", "scale", "ocr", "warnings", "visualReviewRequired", "files", "visuals"],
  "properties": {
    "version": {"const": 2},
    "documentId": {"type": "string"},
    "page": {"type": "integer", "minimum": 1},
    "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "kind": {"enum": ["pdf", "markdown"]},
    "originalPreserved": {"type": "boolean"},
    "region": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "cacheKey": {"type": "string"},
    "width": {"type": "number"},
    "height": {"type": "number"},
    "scale": {"type": "number"},
    "nativeCharacters": {"type": "integer", "minimum": 0},
    "ocrCharacters": {"type": "integer", "minimum": 0},
    "textCharacters": {"type": "integer", "minimum": 0},
    "blockCount": {"type": "integer", "minimum": 0},
    "tableCount": {"type": "integer", "minimum": 0},
    "ocr": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "visualReviewRequired": {"const": true},
    "files": {"type": "array", "items": {"type": "string"}},
    "visuals": {"type": "array"}
  },
  "additionalProperties": true
}
